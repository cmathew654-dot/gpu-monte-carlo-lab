{
  "name": "gpu-monte-carlo-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:sim": "esbuild src/validation/cpuSim.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.tmp/cpuSim.test.bundle.mjs && node node_modules/.tmp/cpuSim.test.bundle.mjs",
    "test:gauntlet": "esbuild src/sim/gauntlet/gauntlet.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.tmp/gauntlet.test.bundle.mjs && node node_modules/.tmp/gauntlet.test.bundle.mjs",
    "test:stats":"esbuild src/sim/stats/stats.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.tmp/stats.test.bundle.mjs && node node_modules/.tmp/stats.test.bundle.mjs && esbuild src/sim/stats/snapStats.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.tmp/snapStats.test.bundle.mjs && node node_modules/.tmp/snapStats.test.bundle.mjs",
    "test:validate": "esbuild src/validation/validate.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/validate.bundle.mjs && node node_modules/.tmp/validate.bundle.mjs",
    "test:probe-launcher": "node probe/launcherPaths.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "plugin-inspect-react-code": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
